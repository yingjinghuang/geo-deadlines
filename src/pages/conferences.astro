---
import DashboardPage from '../components/DashboardPage.astro';
import { getDerivedOpportunities, topics } from '../lib/data';
import { sortUpcoming } from '../lib/opportunity';
const items = sortUpcoming((await getDerivedOpportunities()).filter((item) => item.raw.type === 'conference' && item.submissionStatus !== 'closed'));
---
<DashboardPage title="Conference deadlines" description="Upcoming paper, poster, demo, and doctoral-consortium deadlines for geospatial research conferences." items={items} topics={topics} fixedType="conference" canonicalPath="conferences/" />
