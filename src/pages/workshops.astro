---
import DashboardPage from '../components/DashboardPage.astro';
import { getDerivedOpportunities, topics } from '../lib/data';
import { sortUpcoming } from '../lib/opportunity';
const items = sortUpcoming((await getDerivedOpportunities()).filter((item) => item.raw.type === 'workshop' && item.submissionStatus !== 'closed'));
---
<DashboardPage title="Workshop deadlines" description="Standalone and conference-affiliated workshop submission deadlines across the geospatial research community." items={items} topics={topics} fixedType="workshop" canonicalPath="workshops/" />
