---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  activePath?: string;
  image?: string;
}

const {
  title = 'GeoDeadlines',
  description = 'Conference and special-issue deadlines for GIScience, GeoAI, Geography, Remote Sensing, and Spatial Computing.',
  canonicalPath = '',
  activePath = Astro.url.pathname,
  image = 'og-default.svg',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(canonicalPath.replace(/^\//, ''), new URL(base, Astro.site)).toString();
const imageUrl = new URL(image.replace(/^\//, ''), new URL(base, Astro.site)).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <Header activePath={activePath} />
    <slot />
    <Footer />
    <script>
      import '../scripts/countdown';
      import '../scripts/favorites';
      import '../scripts/deadline-browser';
    </script>
  </body>
</html>
